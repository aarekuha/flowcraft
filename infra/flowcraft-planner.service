[Unit]
Description=Flowcraft production planner
After=network.target flowcraft-backend.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/flowcraft/apps/backend
Environment=PATH=/home/ubuntu/flowcraft/apps/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/flowcraft/apps/backend/.venv/bin/python -m app.scripts.run_planner
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
